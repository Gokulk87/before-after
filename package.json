{
  "name": "before-after-compare",
  "version": "0.3.0",
  "description": "Compare your working copy with another git ref, live in the browser: side by side or swipe, with synced scroll, routes and mirrored clicks. Works with Vite apps and plain HTML sites; `npx before-after init` sets it up.",
  "type": "module",
  "license": "MIT",
  "author": "Gokul Krishnan",
  "keywords": [
    "before-after",
    "compare",
    "design-system",
    "diff",
    "html",
    "migration",
    "static-site",
    "ui-review",
    "visual-regression",
    "vite",
    "vite-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gokulk87/before-after.git"
  },
  "homepage": "https://github.com/Gokulk87/before-after#readme",
  "bugs": "https://github.com/Gokulk87/before-after/issues",
  "bin": {
    "before-after": "bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/config.mjs"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "default": "./src/vite.mjs"
    },
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "bin",
    "src",
    "types",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "vite": "^6.4.5"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/smoke.mjs && node test/smoke-static.mjs",
    "pack:check": "npm pack --dry-run",
    "art": "node art/capture.mjs && node art/record.mjs"
  }
}
